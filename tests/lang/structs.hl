import "inc/shapes.hl"

func main() {
    b := Box{name: "crate", size: Size{w: 3, h: 4}, open: true}
    b.tags = append(b.tags, "wood", "big")
    println(b.name, area(b), b.open, len(b.tags), b.tags[1])
    var empty Box
    println("empty:", json(empty), len(empty.tags), empty.name == "")
    b.open = !b.open
    println(json(b))
    grid := [][]int{}
    grid = append(grid, []int{1, 2}, []int{3})
    println(len(grid), grid[0][1], json(grid))
}
