// Uses Hola's own read_file tool through the prelude's reader agent.
agent FileAsker extends reader {
    deny ["search_code"]
    skills ["brief"]
    output {
        first_line string
    }
}

func main() {
    r := FileAsker{prompt: "What is the first line of sample.txt?"}.run()
    println("first:", r.first_line)
}
